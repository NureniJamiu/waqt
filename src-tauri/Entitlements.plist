<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Required for the minimize-before-overlay sweep.

	  Tauri signs release builds with the hardened runtime, which blocks
	  outgoing Apple Events unless this entitlement is present. Without it
	  the sweep fails with errAEEventNotPermitted (-1743) and no prompt is
	  ever shown to the user - which is why the feature can appear to work
	  under `tauri dev` (where TCC attributes the request to the terminal)
	  and do nothing at all in the packaged .app.
	-->
	<key>com.apple.security.automation.apple-events</key>
	<true/>

	<!--
	  osascript is spawned as a child process; the hardened runtime otherwise
	  refuses to load it under some signing configurations.
	-->
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
